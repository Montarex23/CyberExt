{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "2.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "pl",
  "minimum_chrome_version": "116",

  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "scripting"
  ],

  "optional_permissions": [
    "browsingData"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared/crypto.js", "shared/link-text.js", "content/ui.js", "content/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "phishing_main",
        "enabled": true,
        "path": "rules/main.json"
      },
      {
        "id": "phishing_archive",
        "enabled": true,
        "path": "rules/archive.json"
      }
    ]
  },

  "web_accessible_resources": [
    {
      "resources": ["pages/warning/*", "pages/common.css", "pages/i18n.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "options_ui": {
    "page": "pages/options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "pages/popup/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
